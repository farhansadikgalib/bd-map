{
  "name": "@farhansadikgalib/bd-map",
  "version": "1.0.0",
  "description": "Interactive drill-down maps of Bangladesh for React, plus a geography and data API for Node: division to union, English and Bangla names, choropleths from JSON or an API, and server-side SVG rendering. Zero dependencies.",
  "keywords": [
    "bangladesh",
    "map",
    "react",
    "svg",
    "choropleth",
    "geo",
    "division",
    "district",
    "upazila",
    "union",
    "visualization"
  ],
  "homepage": "https://github.com/farhansadikgalib/bd-map#readme",
  "bugs": "https://github.com/farhansadikgalib/bd-map/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farhansadikgalib/bd-map.git"
  },
  "license": "MIT",
  "author": "Farhan Sadik Galib <farhans.galib@gmail.com> (https://farhansadikgalib.com)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "data": "node scripts/convert-dart-data.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit && vitest run",
    "prepublishOnly": "npm run build && npm test",
    "example": "vite example --open",
    "example:build": "vite build example",
    "banner": "node scripts/make-banner.mjs",
    "social": "node scripts/make-social.mjs"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true
  }
}
